# App
# Public values only. Never put secrets in NEXT_PUBLIC_* variables.
# Vercel production requires HTTPS (not localhost) for NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Search Console / analytics hooks (public measurement IDs only).
# Leave blank until properties exist. Do not send buyer/source identity to analytics.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Supabase - public / browser-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase - SERVER ONLY. Never prefix with NEXT_PUBLIC.
# Use the project's current secret/service credential. Map a legacy
# service-role key to this name if that is what the project still exposes.
SUPABASE_SECRET_KEY=

# Dodo Payments - SERVER ONLY
# test_mode allows missing keys (checkout/webhook/portal then return HTTP 503).
# live_mode requires live API/webhook keys, HTTPS return URL, and live product IDs.
# Do not set live_mode with test keys or local fixture product IDs.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/checkout/success
DODO_PRO_MONTHLY_PRODUCT_ID=
DODO_PRO_ANNUAL_PRODUCT_ID=

# DealAtlas transactional/alert email - SERVER ONLY
# Production sending requires a real from-address. localhost and example.com are skipped.
RESEND_API_KEY=
DEALATLAS_EMAIL_FROM=
# Optional recipient for `npm run send-alerts -- --test-email` / jobs --mode test
DEALATLAS_EMAIL_TEST_TO=

# Optional monitoring - SERVER ONLY
SENTRY_DSN=

# Optional LLM for preview paraphrase / paid summaries - SERVER ONLY.
# Deterministic leak scanning always runs after model output and cannot be overridden.
DEALATLAS_LLM_API_KEY=
DEALATLAS_LLM_BASE_URL=
DEALATLAS_LLM_MODEL=

# Optional embeddings for profile/deal semantic similarity - SERVER ONLY.
# Semantic matching is skipped unless DEALATLAS_EMBEDDING_MODEL and an API key
# (DEALATLAS_EMBEDDING_API_KEY or DEALATLAS_LLM_API_KEY) are set.
DEALATLAS_EMBEDDING_API_KEY=
DEALATLAS_EMBEDDING_BASE_URL=
DEALATLAS_EMBEDDING_MODEL=
