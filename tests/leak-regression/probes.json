{
  "$comment": "Probe list for the Leak regression (local) CI job. See docs/TESTING.md 'Leak regression (local)' for the format. Every probe runs in both phases unless 'phases' says otherwise; anon and free probes fail if any protected token from tests/leak-regression/world.json appears in the response (raw or decoded).",
  "lists": {
    "staticPages": ["pricing", "how-it-works", "login", "signup", "contact", "privacy", "terms", "cookies"],
    "canonicalTables": [
      "deals",
      "organizations",
      "organization_aliases",
      "organization_contacts",
      "notices",
      "documents",
      "lots",
      "locations",
      "deal_locations",
      "awards",
      "award_suppliers",
      "contracts",
      "data_sources",
      "raw_records"
    ]
  },
  "probes": [
    { "id": "home", "kind": "http", "actor": "anon", "path": "/", "views": ["body", "meta", "jsonld"], "expect": { "status": 200 } },
    { "id": "home-rsc", "kind": "http", "actor": "anon", "path": "/", "rsc": true, "expect": { "status": 200 } },
    { "id": "home-query", "kind": "http", "actor": "anon", "path": "/?q={term}", "forEach": "searchTerms", "expect": { "status": 200 } },
    { "id": "deals-index", "kind": "http", "actor": "anon", "path": "/deals", "views": ["body", "meta", "jsonld"], "expect": { "status": 200, "mustContainAll": "publishedPreviewTitles" } },
    { "id": "deals-index-rsc", "kind": "http", "actor": "anon", "path": "/deals", "rsc": true, "expect": { "status": 200 } },
    { "id": "deals-search-page", "kind": "http", "actor": "anon", "path": "/deals?q={term}", "forEach": "searchTerms", "expect": { "status": 200 } },
    { "id": "deals-filtered", "kind": "http", "actor": "anon", "path": "/deals?category={categorySlug}", "forEach": "categories", "expect": { "status": 200 } },
    {
      "id": "deal-detail-published",
      "kind": "http",
      "actor": "anon",
      "path": "/deals/{slug}",
      "forEach": "publishedPreviews",
      "views": ["body", "meta", "jsonld"],
      "expect": { "status": 200, "mustContain": ["{previewTitle}"], "mustNotContain": ["{dealId}"], "nonEmptyViews": ["meta"] }
    },
    { "id": "deal-detail-published-rsc", "kind": "http", "actor": "anon", "path": "/deals/{slug}", "rsc": true, "forEach": "publishedPreviews", "expect": { "status": 200, "mustNotContain": ["{dealId}"] } },
    { "id": "deal-detail-hidden", "kind": "http", "actor": "anon", "path": "/deals/{slug}", "forEach": "hiddenPreviews", "views": ["body", "meta", "jsonld"], "expect": { "status": [200, 404], "mustContain": ["Opportunity not found"] } },
    { "id": "deal-detail-hidden-rsc", "kind": "http", "actor": "anon", "path": "/deals/{slug}", "rsc": true, "forEach": "hiddenPreviews", "expect": { "status": [200, 404] } },
    { "id": "categories-index", "kind": "http", "actor": "anon", "path": "/categories", "views": ["body", "meta", "jsonld"], "expect": { "status": 200 } },
    { "id": "category-page", "kind": "http", "actor": "anon", "path": "/categories/{categorySlug}", "forEach": "categories", "views": ["body", "meta", "jsonld"], "expect": { "status": 200 } },
    { "id": "category-page-rsc", "kind": "http", "actor": "anon", "path": "/categories/{categorySlug}", "rsc": true, "forEach": "categories", "expect": { "status": 200 } },
    { "id": "api-search", "kind": "http", "actor": "anon", "path": "/api/search?q={term}", "forEach": "searchTerms", "views": ["body", "items"], "expect": { "status": 200 } },
    { "id": "api-search-all", "kind": "http", "actor": "anon", "path": "/api/search", "expect": { "status": 200, "mustContainAll": "publishedSlugs" } },
    { "id": "api-search-category", "kind": "http", "actor": "anon", "path": "/api/search?category={categoryName}", "forEach": "categories", "expect": { "status": 200 } },
    { "id": "sitemap-root", "kind": "http", "actor": "anon", "path": "/sitemap.xml", "expect": { "status": 200 } },
    { "id": "sitemap-deals", "kind": "http", "actor": "anon", "path": "/deals/sitemap/0.xml", "expect": { "status": 200, "mustContainAll": "publishedSlugs" } },
    { "id": "robots", "kind": "http", "actor": "anon", "path": "/robots.txt", "expect": { "status": 200 } },
    { "id": "static-page", "kind": "http", "actor": "anon", "path": "/{page}", "forEach": "staticPages", "views": ["body", "meta", "jsonld"], "expect": { "status": 200 } },
    { "id": "api-deal-anon", "kind": "http", "actor": "anon", "path": "/api/deals/{dealId}", "forEach": "allDeals", "expect": { "status": 401 } },
    { "id": "api-alerts-anon", "kind": "http", "actor": "anon", "path": "/api/alerts", "expect": { "status": 401 } },
    { "id": "api-buyers-anon", "kind": "http", "actor": "anon", "path": "/api/buyers", "expect": { "status": [401, 403] } },
    { "id": "api-suppliers-anon", "kind": "http", "actor": "anon", "path": "/api/suppliers", "expect": { "status": [401, 403] } },
    { "id": "api-contracts-anon", "kind": "http", "actor": "anon", "path": "/api/contracts", "expect": { "status": [401, 403] } },

    { "id": "free-home", "kind": "http", "actor": "free", "path": "/", "views": ["body", "meta", "jsonld"], "expect": { "status": 200 } },
    { "id": "free-deals-index", "kind": "http", "actor": "free", "path": "/deals", "expect": { "status": 200, "mustContainAll": "publishedPreviewTitles" } },
    { "id": "free-deal-detail", "kind": "http", "actor": "free", "path": "/deals/{slug}", "forEach": "publishedPreviews", "views": ["body", "meta", "jsonld"], "expect": { "status": 200, "mustContain": ["{previewTitle}"] } },
    { "id": "free-deal-detail-rsc", "kind": "http", "actor": "free", "path": "/deals/{slug}", "rsc": true, "forEach": "publishedPreviews", "expect": { "status": 200 } },
    { "id": "free-deal-detail-hidden", "kind": "http", "actor": "free", "path": "/deals/{slug}", "forEach": "hiddenPreviews", "expect": { "status": [200, 404], "mustContain": ["Opportunity not found"] } },
    { "id": "free-api-search", "kind": "http", "actor": "free", "path": "/api/search?q={term}", "forEach": "searchTerms", "views": ["body", "items"], "expect": { "status": 200 } },
    { "id": "free-app-home", "kind": "http", "actor": "free", "path": "/app", "expect": { "status": 200 } },
    { "id": "free-app-search", "kind": "http", "actor": "free", "path": "/app/search?q={term}", "forEach": "searchTerms", "expect": { "status": 200 } },
    { "id": "free-app-deal", "kind": "http", "actor": "free", "path": "/app/deals/{dealId}", "forEach": "allDeals", "expect": { "status": [200, 404] } },
    { "id": "free-app-deal-rsc", "kind": "http", "actor": "free", "path": "/app/deals/{dealId}", "rsc": true, "forEach": "allDeals", "expect": { "status": [200, 404] } },
    { "id": "free-app-saved", "kind": "http", "actor": "free", "path": "/app/saved", "expect": { "status": 200 } },
    { "id": "free-app-alerts", "kind": "http", "actor": "free", "path": "/app/alerts", "expect": { "status": 200 } },
    { "id": "free-app-alerts-rsc", "kind": "http", "actor": "free", "path": "/app/alerts", "rsc": true, "expect": { "status": 200 } },
    { "id": "free-api-alerts", "kind": "http", "actor": "free", "path": "/api/alerts", "expect": { "status": 200, "mustContain": ["\"items\""] } },
    { "id": "free-api-deal", "kind": "http", "actor": "free", "path": "/api/deals/{dealId}", "forEach": "allDeals", "expect": { "status": [402, 403, 404] } },
    { "id": "free-api-buyers", "kind": "http", "actor": "free", "path": "/api/buyers", "expect": { "status": [402, 403] } },
    { "id": "free-api-suppliers", "kind": "http", "actor": "free", "path": "/api/suppliers", "expect": { "status": [402, 403] } },
    { "id": "free-api-contracts", "kind": "http", "actor": "free", "path": "/api/contracts", "expect": { "status": [402, 403] } },
    { "id": "free-entitlement", "kind": "http", "actor": "free", "path": "/api/billing/entitlement", "expect": { "status": 200 } },

    { "id": "rest-canonical-anon", "kind": "rest", "actor": "anon", "path": "/rest/v1/{table}?select=*&limit=20", "forEach": "canonicalTables", "expect": { "status": [401, 403] } },
    { "id": "rest-canonical-free", "kind": "rest", "actor": "free", "path": "/rest/v1/{table}?select=*&limit=20", "forEach": "canonicalTables", "expect": { "status": [401, 403] } },
    {
      "id": "rest-previews-anon",
      "kind": "rest",
      "actor": "anon",
      "path": "/rest/v1/deal_previews?select=*",
      "expectByPhase": { "pre-0019": { "status": 200 }, "post-0019": { "status": [401, 403] } }
    },
    {
      "id": "rest-previews-free",
      "kind": "rest",
      "actor": "free",
      "path": "/rest/v1/deal_previews?select=*",
      "expectByPhase": { "pre-0019": { "status": 200 }, "post-0019": { "status": [401, 403] } }
    },
    {
      "id": "rpc-legacy-search-anon",
      "kind": "rpc",
      "actor": "anon",
      "fn": "search_deal_previews",
      "args": { "p_query": "{term}" },
      "forEach": "searchTerms",
      "expectByPhase": { "pre-0019": { "status": [200, 404] }, "post-0019": { "status": [401, 403, 404] } }
    },
    { "id": "rpc-search-anon", "kind": "rpc", "actor": "anon", "fn": "search_preview_dtos", "args": { "p_query": "{term}" }, "forEach": "searchTerms", "expect": { "status": 200 } },
    { "id": "rpc-search-all-anon", "kind": "rpc", "actor": "anon", "fn": "search_preview_dtos", "args": {}, "expect": { "status": 200, "mustContainAll": "publishedSlugs" } },
    { "id": "rpc-slug-published-anon", "kind": "rpc", "actor": "anon", "fn": "get_preview_dto_by_slug", "args": { "p_slug": "{slug}" }, "forEach": "publishedPreviews", "expect": { "status": 200, "mustContain": ["{previewTitle}"], "mustNotContain": ["{dealId}"] } },
    { "id": "rpc-slug-hidden-anon", "kind": "rpc", "actor": "anon", "fn": "get_preview_dto_by_slug", "args": { "p_slug": "{slug}" }, "forEach": "hiddenPreviews", "expect": { "status": 200, "emptyResult": true } },
    { "id": "rpc-sitemap-anon", "kind": "rpc", "actor": "anon", "fn": "list_preview_sitemap_entries", "args": {}, "expect": { "status": 200, "mustContainAll": "publishedSlugs" } },
    { "id": "rpc-sitemap-count-anon", "kind": "rpc", "actor": "anon", "fn": "count_preview_sitemap_entries", "args": {}, "expect": { "status": 200 } },
    { "id": "rpc-by-deal-id-anon", "kind": "rpc", "actor": "anon", "fn": "get_preview_dto_by_deal_id", "args": { "p_deal_id": "{dealId}" }, "forEach": "allDeals", "expect": { "status": [401, 403, 404] } },
    { "id": "rpc-search-free", "kind": "rpc", "actor": "free", "fn": "search_preview_dtos", "args": { "p_query": "{term}" }, "forEach": "searchTerms", "expect": { "status": 200 } },
    { "id": "rpc-by-deal-id-free", "kind": "rpc", "actor": "free", "fn": "get_preview_dto_by_deal_id", "args": { "p_deal_id": "{dealId}" }, "forEach": "publishedPreviews", "expect": { "status": 200, "mustContain": ["{previewTitle}"] } },
    { "id": "rpc-by-deal-id-hidden-free", "kind": "rpc", "actor": "free", "fn": "get_preview_dto_by_deal_id", "args": { "p_deal_id": "{dealId}" }, "forEach": "hiddenPreviews", "expect": { "status": 200, "emptyResult": true } },
    { "id": "rpc-saved-free", "kind": "rpc", "actor": "free", "fn": "list_saved_deal_previews", "args": {}, "expect": { "status": 200 } },
    { "id": "rpc-resolve-free", "kind": "rpc", "actor": "free", "fn": "resolve_preview_deal_id", "args": { "p_slug": "{slug}" }, "forEach": "hiddenPreviews", "expect": { "status": 200, "emptyResult": true } },

    {
      "id": "pro-api-deal",
      "kind": "http",
      "actor": "pro",
      "path": "/api/deals/{dealId}",
      "forEach": "publishedPreviews",
      "tokens": "allow",
      "expect": { "status": 200, "mustContain": ["{sourceTitle}", "{reference}"] }
    },
    {
      "id": "pro-app-deal",
      "kind": "http",
      "actor": "pro",
      "path": "/app/deals/{dealId}",
      "forEach": "publishedPreviews",
      "tokens": "allow",
      "expect": { "status": 200, "mustContain": ["{reference}"] }
    },
    { "id": "pro-entitlement", "kind": "http", "actor": "pro", "path": "/api/billing/entitlement", "tokens": "allow", "expect": { "status": 200, "mustContain": ["PRO"] } }
  ]
}
